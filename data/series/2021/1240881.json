{
  "title": "WOJENNE DZIEWCZYNY",
  "production_years": "2017",
  "locations": [
    "Warszawa",
    "Lublin (Stare Miasto)",
    "Piaseczno",
    "Żyrardów",
    "Milanówek",
    "Łęczyca",

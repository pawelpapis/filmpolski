  "title": "TULIPAN",
  "production_years": "1986",
  "locations": [
    "Konstancin-Jeziorna (nieistniejąca dziś restauracja \"Świerkowa\" przy ul. Piasta 24)",
    "Konstancin-Jeziorna (Stara Papiernia przy ul. Wojska Polskiego 3)"

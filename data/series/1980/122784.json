{
  "title": "Z BIEGIEM LAT, Z BIEGIEM DNI...",
  "production_years": "1980",
  "locations": [
    "Kraków (Teatr im. Słowackiego przy Placu Świętego Ducha 1)",
    "Kraków (ulice: Floriańska)",
    "Kraków (Kanonicza)",
